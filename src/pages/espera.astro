---
import Layout from "../layouts/Layout.astro";
// 16/11/2026 21h de Brasília. O portão de verdade é o middleware.ts; aqui é só a vitrine.
const ABERTURA = "2026-11-17T00:00:00Z";
---

<Layout noAds title="Impostor do Futebol · estreia 16/11 às 21h" description="O Impostor do Futebol estreia dia 16/11 às 21h. Quem tem chave joga antes.">
  <main class="gate">
    <div class="glow" aria-hidden="true"></div>
    <div class="lines" aria-hidden="true"></div>

    <header class="gtop">
      <span class="blogo"><img src="/bode.png" alt="" /><img class="lg" src="/logo-impostor.png" alt="Impostor"></span>
    </header>

    <section class="gbody">
      <img class="gbanner" src="/img/landing/bodes-1400.webp" srcset="/img/landing/bodes-800.webp 800w, /img/landing/bodes-1400.webp 1400w" sizes="(max-width: 900px) 100vw, 900px" width="1400" height="717" fetchpriority="high" alt="Você é o Impostor: um time de bodes de camisa amarela e um só de camisa listrada. Finja que você sabe o jogador ou clube." />

      <p class="kick">Estreia · segunda, 16/11 · 21h</p>
      <h1>Todo mundo sabe o craque.<br /><span>Menos um.</span></h1>

      <div class="count" id="count" data-open={ABERTURA} role="timer" aria-live="off" aria-label="Tempo até a estreia">
        <div class="cell"><b id="d">--</b><small>dias</small></div>
        <div class="cell"><b id="h">--</b><small>horas</small></div>
        <div class="cell"><b id="m">--</b><small>min</small></div>
        <div class="cell sec"><b id="s">--</b><small>seg</small></div>
      </div>

      <form class="key" id="keyForm" autocomplete="off">
        <label for="keyIn">Se você tiver uma chave para jogar, coloque aqui</label>
        <div class="krow">
          <input id="keyIn" class="field" placeholder="SUA CHAVE" maxlength="24" autocapitalize="characters" spellcheck="false" aria-describedby="keyErr" />
          <button class="btn btn-red" id="keyBtn" type="submit">Entrar</button>
        </div>
        <p class="err" id="keyErr" role="alert" hidden></p>
      </form>
    </section>

    <section class="lp how" id="como">
      <h2>Como funciona</h2>
      <ol class="steps">
        <li><b>1</b><h3>Todo mundo recebe uma carta</h3><p>Um craque ou um time de futebol. Só que um de vocês recebe <em>impostor</em> e não sabe quem é.</p></li>
        <li><b>2</b><h3>Cada um solta uma pista</h3><p>Fale algo que prove que você sabe de quem se trata, sem entregar de bandeja pro impostor.</p></li>
        <li><b>3</b><h3>Votem em quem tá blefando</h3><p>Pegou o impostor? Ponto pra galera. Se ele escapar, ainda tem o chute final pra virar o jogo.</p></li>
      </ol>
    </section>

    <section class="lp cards">
      <div class="pair">
        <div class="mcard ok"><small>sua carta</small><strong>O CRAQUE É</strong><span>? ? ? ? ?</span><em>fale uma pista</em></div>
        <div class="mcard bad"><small>sua carta</small><strong>IMPOSTOR</strong><span>shhh</span><em>disfarça, ninguém pode saber</em></div>
      </div>
      <p class="cap">Duas pessoas, duas cartas. Só uma sabe o que está acontecendo.</p>
    </section>

    <section class="lp feat">
      <h2>Do jeito que o grupo quiser</h2>
      <div class="fgrid">
        <div class="f"><h3>Cada um no seu celular</h3><p>Cria a sala, manda o link no grupo e cada um entra do próprio aparelho. Sem baixar nada.</p></div>
        <div class="f"><h3>Modo Local</h3><p>Um celular só, passando de mão em mão. Perfeito pra resenha, churrasco e mesa de bar.</p></div>
        <div class="f"><h3>12 temas de futebol</h3><p>Jogadores de hoje, antigos, lendas, goleiros, gringos do Brasileirão e clubes do mundo todo. Quanto mais você conhece, mais difícil é blefar.</p></div>
        <div class="f"><h3>3 a 15 jogadores</h3><p>Do rachão de três ao grupão inteiro. Pontuação e ranking no fim.</p></div>
      </div>
    </section>

    <section class="lp share">
      <h2>Chama a resenha</h2>
      <p>A estreia é dia 16/11 às 21h. Marca o grupo.</p>
      <div class="srow">
        <button class="btn btn-red" id="shareBtn" type="button">Compartilhar</button>
        <a class="btn" id="waBtn" href="#" target="_blank" rel="noopener">WhatsApp</a>
      </div>
      <p class="ok" id="shareMsg" hidden>Link copiado.</p>
    </section>

    <footer class="gfoot">Jogo de impostor com temas de futebol · cada um joga do próprio celular.</footer>
  </main>
</Layout>

<style is:global>
  .gate{position:relative;min-height:100svh;display:flex;flex-direction:column;overflow:hidden;background:#050505}
  .gate .glow{position:absolute;inset:0;background:radial-gradient(ellipse 60% 40% at 50% 38%,rgba(255,212,0,.16),transparent 75%);pointer-events:none}
  .gate .lines{position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,.022) 0 64px,transparent 64px 128px);pointer-events:none;mask-image:linear-gradient(#000,transparent 85%)}
  .gtop .blogo{gap:10px}.gtop .blogo img{height:44px}.gtop .blogo img.lg{height:36px}
  .gtop{position:relative;padding-bottom:14px !important;display:flex;justify-content:center;padding:calc(18px + env(safe-area-inset-top,0px)) 16px 0}
  .gbody{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;text-align:center;padding:12px 16px 24px;max-width:900px;width:100%;margin:0 auto;gap:14px}
  .gate .mascote{position:relative;width:min(78vw,340px);aspect-ratio:765/545;margin-bottom:-6px;filter:drop-shadow(0 10px 30px rgba(0,0,0,.6));animation:gFloat 4s ease-in-out infinite}
  .gate .mascote img{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .gate .gbanner{display:block;width:calc(100% + 24px);max-width:900px;height:auto;margin:0 -12px -10px;-webkit-mask-image:linear-gradient(#000 80%,transparent);mask-image:linear-gradient(#000 80%,transparent)}
  @keyframes gFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  .gate .kick{font-family:var(--display);color:var(--accent);letter-spacing:.2em;font-size:18px;margin:0}
  .gate h1{font-size:clamp(34px,8vw,56px);line-height:.98;margin:0}
  .gate h1 span{color:var(--accent)}
  .count{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;width:100%;max-width:520px;margin:10px 0 6px}
  .count .cell{background:var(--card);border:1.5px solid var(--line);border-radius:14px;padding:12px 4px 8px;position:relative;overflow:hidden}
  .count .cell::after{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:rgba(0,0,0,.55)}
  .count b{display:block;font-family:var(--display);font-weight:400;font-size:clamp(46px,14vw,84px);line-height:.95;color:#fff;font-variant-numeric:tabular-nums}
  .count small{display:block;font-family:var(--display);letter-spacing:.18em;color:var(--muted);font-size:14px;margin-top:2px}
  .count .sec{border-color:var(--accent)}
  .count .sec b{color:var(--accent)}
  .count .sec b.tick{animation:gTick .35s ease-out}
  @keyframes gTick{from{transform:translateY(-8px);opacity:.3}to{transform:none;opacity:1}}
  .key{width:100%;max-width:440px;margin-top:18px;display:grid;gap:10px}
  .key label{color:var(--muted);font-size:14px}
  .key .krow{display:grid;grid-template-columns:1fr auto;gap:8px}
  .key .field{text-transform:uppercase;letter-spacing:.2em;text-align:center;font-weight:800}
  .key .err{text-align:left}
  .gfoot{position:relative;text-align:center;color:var(--muted);font-size:12px;padding:16px 16px calc(16px + env(safe-area-inset-bottom,0px))}

  .lp{position:relative;width:100%;max-width:880px;margin:0 auto;padding:44px 16px 8px;text-align:center}
  .lp h2{font-family:var(--display);font-weight:400;font-size:clamp(32px,7vw,48px);letter-spacing:.02em;margin:0 0 22px;color:#fff}
  .lp h3{font-size:17px;margin:8px 0 6px;color:#fff}
  .lp p{color:var(--muted);margin:0;line-height:1.5;font-size:15px}
  .lp em{color:var(--accent);font-style:normal;font-weight:700}
  .steps{list-style:none;margin:0;padding:0;display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));text-align:left}
  .steps li{background:var(--card);border:1.5px solid var(--line);border-radius:16px;padding:18px}
  .steps b{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--accent);color:#000;font-family:var(--display);font-weight:400;font-size:24px}
  .pair{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:520px;margin:0 auto}
  .mcard{aspect-ratio:3/4;border-radius:18px;padding:14px 10px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:8px;border:2px solid var(--line);background:linear-gradient(160deg,#171717,#0b0b0b);transition:transform .25s}
  .mcard small{color:var(--muted);font-size:11px;letter-spacing:.14em;text-transform:uppercase}
  .mcard strong{font-family:var(--display);font-weight:400;font-size:clamp(24px,6.5vw,34px);line-height:1}
  .mcard span{font-family:var(--display);font-size:clamp(20px,5vw,28px);letter-spacing:.2em;color:#fff}
  .mcard em{font-size:12px;color:var(--muted);font-style:normal}
  .mcard.ok{border-color:var(--accent);transform:rotate(-3deg)}.mcard.ok strong{color:var(--accent)}
  .mcard.bad{border-color:#e5322d;transform:rotate(3deg);background:linear-gradient(160deg,#2a0a09,#0b0b0b)}.mcard.bad strong{color:#ff4a43}
  .pair:hover .mcard{transform:none}
  .cap{margin-top:16px !important}
  .fgrid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));text-align:left}
  .fgrid .f{border-left:3px solid var(--accent);padding:4px 0 4px 14px}
  .share .srow{display:flex;gap:10px;justify-content:center;margin-top:18px;flex-wrap:wrap}
  .share .srow .btn{min-width:150px;text-decoration:none;text-align:center;display:inline-flex;align-items:center;justify-content:center}
  .share .srow a.btn{background:#25d366;color:#04210f;border-color:#25d366}
  .share .ok{margin-top:12px;color:var(--accent)}
  .rv{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
  .rv.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}}
  .gate.open .count{opacity:.5}
  @media (prefers-reduced-motion:reduce){.gate .mascote,.count .sec b.tick{animation:none}}
</style>

<script>
  const root = document.getElementById("count")!;
  const open = Date.parse(root.dataset.open!);
  const $ = (id: string) => document.getElementById(id)!;
  let last = -1;
  let reloading = false;

  async function liberado(): Promise<boolean> {
    try {
      const r = await fetch("/?_=" + Date.now(), { cache: "no-store", headers: { accept: "text/html" } });
      return r.ok && r.headers.get("x-impostor-gate") !== "1";
    } catch {
      return false;
    }
  }

  function tick() {
    const ms = Math.max(0, open - Date.now());
    const t = Math.floor(ms / 1000);
    const pad = (n: number) => String(n).padStart(2, "0");
    $("d").textContent = pad(Math.floor(t / 86400));
    $("h").textContent = pad(Math.floor((t % 86400) / 3600));
    $("m").textContent = pad(Math.floor((t % 3600) / 60));
    const s = $("s");
    s.textContent = pad(t % 60);
    if (t !== last) {
      s.classList.remove("tick");
      void s.offsetWidth;
      s.classList.add("tick");
      last = t;
    }
    if (ms === 0 && !reloading) {
      reloading = true;
      const go = async () => ((await liberado()) ? (location.href = "/" + location.search) : setTimeout(go, 2000));
      go();
    }
  }
  tick();
  setInterval(tick, 250);

  const form = $("keyForm") as HTMLFormElement;
  const input = $("keyIn") as HTMLInputElement;
  const err = $("keyErr");
  const btn = $("keyBtn") as HTMLButtonElement;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    err.hidden = true;
    if (!input.value.trim()) return;
    btn.disabled = true;
    try {
      const r = await fetch("/api/chave", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ chave: input.value }),
      });
      const j = await r.json().catch(() => ({}));
      if (r.ok && j.ok) {
        location.href = "/" + location.search;
        return;
      }
      err.textContent = j.erro || "Chave inválida.";
    } catch {
      err.textContent = "Sem conexão. Tente de novo.";
    }
    err.hidden = false;
    btn.disabled = false;
    input.select();
  });

  // compartilhar
  const url = location.origin + "/";
  const texto = "Impostor do Futebol estreia 16/11 às 21h. Todo mundo sabe o craque, menos um.";
  $("waBtn").setAttribute("href", "https://wa.me/?text=" + encodeURIComponent(texto + " " + url));
  $("shareBtn").addEventListener("click", async () => {
    try {
      if (navigator.share) {
        await navigator.share({ title: "Impostor do Futebol", text: texto, url });
        return;
      }
      await navigator.clipboard.writeText(url);
      const m = $("shareMsg");
      m.hidden = false;
      setTimeout(() => (m.hidden = true), 2500);
    } catch {}
  });

  // entrada suave das seções
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { threshold: 0.12 });
  document.querySelectorAll(".lp").forEach((el) => { el.classList.add("rv"); io.observe(el); });
</script>
